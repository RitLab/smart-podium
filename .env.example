# =====================================================
# Smart Podium — contoh konfigurasi environment
# Copy ke .env lalu isi nilainya. Semua key WAJIB berawalan
# VITE_ supaya ke-expose ke renderer & electron main lewat Vite.
# =====================================================

# --- Portal API ---------------------------------------------------
# Dipakai sebagai baseURL di src/services/hash.ts
# Endpoint: /portal/teacher/pin/check, /user/login, /portal/classroom, /portal/student
VITE_API_URL=https://portal.example.com/api

# --- Whisper API (recording & event) ------------------------------
# Dipakai sebagai baseWhisperUrl di src/services/hash.ts
# Endpoint: /portal/event, /portal/event/:id, /portal/video/:id/start,
#           /portal/video/stop, /portal/teacher/pin/check
VITE_API_WHISPER_URL=https://whisper.example.com/api

# --- SLMS API (modul / materi) ------------------------------------
# Dipakai sebagai baseURL axios instance di src/services/slms.ts
VITE_API_SLMS_URL=https://slms.example.com/api

# Static Authorization header untuk SLMS API (src/services/slms.ts)
VITE_API_AUTH_CODE=

# --- Request signing ----------------------------------------------
# Secret HMAC SHA-256. Request interceptor di src/services/hash.ts
# menandatangani pathname URL dan mengirimnya sebagai header X-Api-Key.
# Kalau kosong, semua request ditandatangani dengan secret "" dan
# backend akan menolaknya.
VITE_HASH_SECRET=

# --- Auto update (electron-updater) -------------------------------
# GitHub token untuk baca release privat RitLab/smart-podium.
# Dibaca di electron/main/update.ts dan di-grep ulang oleh
# script "publish:win" pada package.json.
VITE_GH_TOKEN=

# =====================================================
# Di bawah ini hanya dibaca oleh src/services/index.ts, yang saat ini
# tidak di-import modul mana pun (semua service pakai ./hash).
# Isi kalau file itu diaktifkan lagi; boleh dikosongkan sekarang.
# =====================================================

# baseURL untuk refresh token otomatis saat response 401 (POST /login)
VITE_API_AUTH_URL=

# Kredensial service account untuk refresh token 401 di atas
VITE_LOGIN_EMAIL=
VITE_LOGIN_PASSWORD=
